    <!-- Connectivity check (upstream connectivity.*) -->
    <string name="action_check_connectivity">Проверить соединение</string>
    <string name="connectivity_title">Проверка соединения</string>
    <string name="connectivity_intro">Проверяет с этого телефона, открывается ли WebSocket каждого датацентра Telegram через ваши правила DC → IP, домены CF-прокси и ваши Cloudflare Worker. Используются сохранённые настройки; запускать прокси не нужно.</string>
    <string name="action_run_check">Запустить проверку</string>
    <string name="connectivity_checking">Проверка…</string>
    <string name="connectivity_nothing">Нечего проверять: нет правил DC → IP (или пул WebSocket равен 0), CF-прокси выключен и нет доменов Cloudflare Worker.</string>
    <string name="connectivity_direct_title">WebSocket через DC → IP</string>
